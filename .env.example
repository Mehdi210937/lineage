# Copie ce fichier en .env et remplis les valeurs. Ne commite jamais .env.

# Contact obligatoire dans le User-Agent pour l'API MusicBrainz (email ou URL GitHub)
LINEAGE_CONTACT=https://github.com/Mehdi210937/lineage

# Jeton personnel Discogs : https://www.discogs.com/settings/developers
# Pour le tester : curl https://api.discogs.com/oauth/identity -H "Authorization: Discogs token=<ton_jeton>"
# Sans jeton, le crawler saute Discogs (les bios ne seront pas récupérées).
DISCOGS_TOKEN=

# Où stocker la base DuckDB et le cache (garde-le HORS de OneDrive si possible)
LINEAGE_DATA_DIR=./data

# Nombre de jours avant de re-télécharger une réponse déjà en cache
LINEAGE_REFRESH_DAYS=30

# LLM local pour l'extraction des influences (phase 3)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
